# ---------------------------------------------------------------------------
# Copy this file to .env and fill in ONE of the credential blocks below.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit it. Never paste a key into a chat, a
# ticket, or a screenshot at the bench.
# ---------------------------------------------------------------------------


# === Which model =============================================================
# bedrock   = Claude via AWS Bedrock        <-- the workshop default
# anthropic = Claude via the Anthropic API
# local     = Llama 3.1 8B via transformers (development only, needs a GPU)
# openai    = OpenAI or Azure

LLM_BACKEND=bedrock

# Bedrock will NOT accept a bare model id. It must be an inference profile id
# or a full ARN, or you get:
#     "Invocation of model ID ... isn't supported ... on-demand throughput"
LLM_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# The region your Bedrock access lives in. Required — the SDK does not guess.
AWS_REGION=eu-north-1


# === Credentials: pick ONE of the two blocks ================================
#
# The two are mutually exclusive. If you set both, the SDK raises
# "Cannot specify both `api_key` and AWS credentials". Comment one out.


# --- Option A: Bedrock API key (recommended) --------------------------------
# One value, no AWS CLI, no boto3, nothing else to install.
# Works for both short-term keys (expire in <= 12 hours) and long-term keys
# (expire on the date they were issued with).
#
# Generate: AWS console -> Amazon Bedrock -> API keys

AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-

# --- Option B: IAM credentials (SigV4) --------------------------------------
# Use this if your organisation issues IAM keys rather than Bedrock API keys.
# Requires `pip install boto3`.
# AWS_SESSION_TOKEN is REQUIRED for temporary/SSO credentials and must be
# omitted entirely for permanent IAM user keys.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Or, if you already have a working profile in ~/.aws/credentials:
# AWS_PROFILE=


# === Other backends ==========================================================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=


# === Optional ================================================================
# 0 = final answer only, 1 = + guardrail decisions and tool calls, 2 = + raw
VERBOSITY=0